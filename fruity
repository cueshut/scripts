-- ============================================================
-- PROJECTILE REDIRECTION (logic unchanged)
-- ============================================================
local SPEED = 60
local STRAIGHT_TIME = 0.2
local DETECT_RANGE = 1000
local HealthPriority = "Nearest"
local DISTANCE_WEIGHT = 0.5
local HEALTH_WEIGHT = 0.5

local NPCS = Workspace:WaitForChild("NPCS")

local function getHumanoidHealth(model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		return humanoid.Health
	end
	return nil
end

local function findClosestNPCPart(distFrom)
	local candidates = {}
	for _, model in ipairs(NPCS:GetChildren()) do
		if model:IsA("Model") then
			for _, partName in ipairs(HITBOX_NAMES) do
				local part = model:FindFirstChild(partName)
				if part and part:IsA("BasePart") then
					local dist = (part.Position - distFrom).Magnitude
					if dist <= DETECT_RANGE then
						table.insert(candidates, {
							part = part,
							dist = dist,
							health = getHumanoidHealth(model),
						})
					end
					break
				end
			end
		end
	end
	if #candidates == 0 then
		return nil
	end
	if HealthPriority == "Lowest" or HealthPriority == "Highest" then
		local withHealth = {}
		for _, c in ipairs(candidates) do
			if c.health then
				table.insert(withHealth, c)
			end
		end
		if #withHealth > 0 then
			table.sort(withHealth, function(a, b)
				if HealthPriority == "Lowest" then
					return a.health < b.health
				else
					return a.health > b.health
				end
			end)
			return withHealth[1].part
		end
	elseif HealthPriority == "NearestLow" then
		local withHealth = {}
		for _, c in ipairs(candidates) do
			if c.health then
				table.insert(withHealth, c)
			end
		end
		if #withHealth > 0 then
			local maxDist, maxHealth = 0, 0
			for _, c in ipairs(withHealth) do
				maxDist = math.max(maxDist, c.dist)
				maxHealth = math.max(maxHealth, c.health)
			end
			maxDist = math.max(maxDist, 0.0001)
			maxHealth = math.max(maxHealth, 0.0001)
			for _, c in ipairs(withHealth) do
				local normDist = c.dist / maxDist
				local normHealth = c.health / maxHealth
				c.score = (normDist * DISTANCE_WEIGHT) + (normHealth * HEALTH_WEIGHT)
			end
			table.sort(withHealth, function(a, b)
				return a.score < b.score
			end)
			return withHealth[1].part
		end
	end
	table.sort(candidates, function(a, b)
		return a.dist < b.dist
	end)
	return candidates[1].part
end

local Tracking = {}
local RocketConnections = {}

local function TrackObject(obj)
	if Tracking[obj] then
		return
	end
	Tracking[obj] = true
	obj.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
	local bodyVel = obj:FindFirstChildOfClass("BodyVelocity")
	if bodyVel then
		bodyVel.MaxForce = Vector3.new(0, 0, 0)
		bodyVel.Velocity = Vector3.new(0, 0, 0)
	end
	local startPos = obj.Position
	local startDir = obj.CFrame.LookVector
	local elapsed = 0
	local target
	local curveStartPos, controlPoint, curveDuration
	local curveT = 0
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		if not obj or not obj.Parent then
			conn:Disconnect()
			Tracking[obj] = nil
			RocketConnections[obj] = nil
			return
		end
		elapsed += dt
		if elapsed < STRAIGHT_TIME then
			local newPos = startPos + startDir * SPEED * elapsed
			obj.CFrame = CFrame.new(newPos, newPos + startDir)
			obj.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
			obj.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
			return
		end
		if not target then
			target = findClosestNPCPart(startPos)
			curveStartPos, controlPoint, curveDuration = nil, nil, nil
			curveT = 0
			if not target then
				local dir = obj.CFrame.LookVector
				obj.CFrame = CFrame.new(obj.Position + dir * SPEED * dt, obj.Position + dir * (SPEED * dt + 1))
				obj.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
				obj.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
				return
			end
		end
		if not target.Parent then
			target = findClosestNPCPart(startPos)
			curveStartPos, controlPoint, curveDuration = nil, nil, nil
			curveT = 0
			if not target then
				local dir = obj.CFrame.LookVector
				obj.CFrame = CFrame.new(obj.Position + dir * SPEED * dt, obj.Position + dir * (SPEED * dt + 1))
				obj.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
				obj.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
				return
			end
		end
		local targetPos = target.Position
		if not curveStartPos then
			curveStartPos = obj.Position
			local dist = (targetPos - curveStartPos).Magnitude
			curveDuration = math.max(dist / SPEED, 0.01)
			controlPoint = curveStartPos + startDir * (dist * 0.5)
		end
		curveT += dt / curveDuration
		if curveT >= 1 then
			obj.CFrame = CFrame.new(targetPos)
			conn:Disconnect()
			Tracking[obj] = nil
			RocketConnections[obj] = nil
			return
		end
		local a = curveStartPos:Lerp(controlPoint, curveT)
		local b = controlPoint:Lerp(targetPos, curveT)
		local point = a:Lerp(b, curveT)
		local facing = (point - obj.Position)
		if facing.Magnitude > 0.001 then
			obj.CFrame = CFrame.new(point, point + facing)
		else
			obj.CFrame = CFrame.new(point)
		end
		obj.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		obj.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
	end)
	RocketConnections[obj] = conn
end

local MainConnection
local function SetupConnections()
	MainConnection = Workspace.ChildAdded:Connect(function(child)
		if not Config.Enabled then
			return
		end
		if child.Name == "GRL_Rocket" and (Config.Mode == "GRL_Rocket" or Config.Mode == "Both") then
			local pp = child:WaitForChild("PP", 2)
			if pp then
				TrackObject(pp)
			end
		end
		if child.Name == "SoD_Orb" and (Config.Mode == "SoD_Orb" or Config.Mode == "Both") then
			TrackObject(child)
		end
		if child.Name == "JTS_MBlade" and (Config.Mode == "JTS_MBlade" or Config.Mode == "Both") then
			TrackObject(child)
		end
	end)
