-- Route modules all share one Step, parameterised by the state fields their
-- submenu writes to.
local function routeStep(state)
	if not travelTo(state.destination, state.leash) then
		warn("[Automation] " .. state.name .. ": destination '" .. tostring(state.destination) .. "' could not be resolved.")
		return
	end
	if state.sell then
		firePrompts(AUTOMATION_TUNING.SellPrompts, state.radius)
	end
	if state.clear then
		meleeSweep(state.radius)
	end
	if state.collect then
		touchCollect(AUTOMATION_TUNING.CollectibleFolders, AUTOMATION_TUNING.CollectibleNames, state.radius)
		firePrompts(AUTOMATION_TUNING.CollectiblePrompts, state.radius)
	end
end

for _, def in ipairs(AUTOMATION_DEFS) do
	local state = {
		name = def.Name,
		enabled = false,
		interval = def.Interval,
		radius = def.Radius and def.Radius.Default or 120,
		leash = 120,
		destination = def.Route,
		clear = not def.Sell,
		collect = not def.Sell,
		sell = def.Sell or false,
		step = def.Step or routeStep,
	}
	AutomationStates[def.Name] = state

	local feature = automationPanel:Feature(def.Name, false, function(on)
		setAutomation(state, on)
	end)
	feature:SetBadge(string.format("%.2gs", state.interval))
	feature:Tooltip(def.Tooltip)

	local menu = feature:Submenu()

	if def.Route then
		menu:Dropdown("Destination", ALL_LOCATION_NAMES, def.Route, function(newValue)
			state.destination = newValue
		end)
		menu:Slider("Leash", 20, 600, state.leash, 10, function(newValue)
			state.leash = newValue
		end, { Suffix = " studs" })
	end

	local radiusSpec = def.Radius or { Min = 10, Max = 400, Default = 120, Label = "Radius" }
	menu:Slider(radiusSpec.Label or "Radius", radiusSpec.Min, radiusSpec.Max, state.radius, 5, function(newValue)
		state.radius = newValue
	end, { Suffix = " studs" })

	menu:Slider("Interval", 0.1, 10, state.interval, 0.1, function(newValue)
		state.interval = newValue
		feature:SetBadge(string.format("%.2gs", newValue))
	end, { Suffix = " s" })

	if def.Route then
		menu:Toggle("Clear Mobs", state.clear, function(on)
			state.clear = on
		end)
		menu:Toggle("Collect Drops", state.collect, function(on)
			state.collect = on
		end)
	end

	menu:Divider()
	addBind(menu, feature, "Bind")
end

