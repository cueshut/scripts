-- ============================================================
-- AUTOMATION PRIMITIVES
-- Shared building blocks every Automation module is composed from. Nothing
-- here touches a private remote: prompts are fired through the executor's
-- fireproximityprompt, swings go through firetouchinterest, and movement
-- reuses teleportTo. That keeps each automation readable and portable.
-- ============================================================

-- Executor capability probes, so a missing global degrades to a warning
-- instead of a hard error mid-loop.
local canFirePrompt = typeof(fireproximityprompt) == "function"
local canFireTouch = typeof(firetouchinterest) == "function"

-- ProximityPromptService tells us exactly which prompts are currently in
-- range. That is far cheaper than walking Workspace:GetDescendants() on a
-- map this size, and it is also the only reliable "can I interact now?" test.
local visiblePrompts = {}
local promptConnections = {}

table.insert(promptConnections, ProximityPromptService.PromptShown:Connect(function(prompt)
	visiblePrompts[prompt] = true
end))
table.insert(promptConnections, ProximityPromptService.PromptHidden:Connect(function(prompt)
	visiblePrompts[prompt] = nil
end))

local function getHRP()
	local char = LocalPlayer.Character
	return char and char:FindFirstChild("HumanoidRootPart") or nil
end

local function getHumanoid()
	local char = LocalPlayer.Character
	return char and char:FindFirstChildOfClass("Humanoid") or nil
end

local function matchesAny(text, keywords)
	if not text or text == "" then
		return false
	end
	local lowered = string.lower(text)
	for _, keyword in ipairs(keywords) do
		if string.find(lowered, keyword, 1, true) then
			return true
		end
	end
	return false
end

-- Fires every in-range prompt whose name, ObjectText or ActionText matches.
-- Passing no keywords fires everything in range.
local function firePrompts(keywords, radius)
	if not canFirePrompt then
		return 0
	end
	local hrp = getHRP()
	if not hrp then
		return 0
	end
	local fired = 0
	for prompt in pairs(visiblePrompts) do
		if not prompt.Parent then
			visiblePrompts[prompt] = nil
		elseif prompt.Enabled then
			local anchor = prompt.Parent
			local ok = true
			if radius and anchor and anchor:IsA("BasePart") then
				ok = (anchor.Position - hrp.Position).Magnitude <= radius
			end
			if ok and keywords then
				ok = matchesAny(prompt.Name, keywords)
					or matchesAny(prompt.ActionText, keywords)
					or matchesAny(prompt.ObjectText, keywords)
					or (anchor and matchesAny(anchor.Name, keywords))
			end
			if ok then
				pcall(fireproximityprompt, prompt)
				fired += 1
			end
		end
	end
	return fired
end

local function getEquippedTool()
	local char = LocalPlayer.Character
	if not char then
		return nil
	end
	return char:FindFirstChildOfClass("Tool")
end

-- Equips the first backpack tool whose name matches, and returns it.
local function equipToolMatching(keywords)
	local equipped = getEquippedTool()
	if equipped and matchesAny(equipped.Name, keywords) then
		return equipped
	end
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	local humanoid = getHumanoid()
	if not (backpack and humanoid) then
		return nil
	end
	for _, tool in ipairs(backpack:GetChildren()) do
		if tool:IsA("Tool") and matchesAny(tool.Name, keywords) then
			humanoid:EquipTool(tool)
			return tool
		end
	end
	return nil
end

local function activateTool(tool)
	tool = tool or getEquippedTool()
	if tool then
		pcall(function()
			tool:Activate()
		end)
	end
	return tool
end

-- The hitbox of whatever is currently equipped, used by the sweeps below.
local function getEquippedHitbox()
	local tool = getEquippedTool()
	if not tool then
		return nil
	end
	for _, name in ipairs(HITBOX_NAMES) do
		local hitbox = tool:FindFirstChild(name, true)
		if hitbox and hitbox:IsA("BasePart") then
			return hitbox
		end
	end
	return nil
end

-- Swings the equipped weapon and force-touches every NPC hitbox in radius.
-- This is the Melee Aura idea driven on a timer instead of on your swing.
local function meleeSweep(radius)
	if not canFireTouch then
		return 0
	end
	activateTool()
	local hitbox = getEquippedHitbox()
	local npcsFolder = Workspace:FindFirstChild("NPCS")
	if not (hitbox and npcsFolder) then
		return 0
	end
	local hits = 0
	for _, npc in ipairs(npcsFolder:GetChildren()) do
		local npcRoot = npc:FindFirstChild("HumanoidRootPart") or npc:FindFirstChildWhichIsA("BasePart")
		if npcRoot and (npcRoot.Position - hitbox.Position).Magnitude <= radius then
			local humanoid = npc:FindFirstChildOfClass("Humanoid")
			if not humanoid or humanoid.Health > 0 then
				for _, name in ipairs(HITBOX_NAMES) do
					local enemyHitbox = npc:FindFirstChild(name)
					if enemyHitbox then
						firetouchinterest(hitbox, enemyHitbox, 0)
						firetouchinterest(hitbox, enemyHitbox, 1)
						hits += 1
					end
				end
			end
		end
	end
	return hits
end

-- Touch-collects loose parts in the named folders. Only the folders listed in
-- AUTOMATION_TUNING are walked, so this stays cheap on a large map.
local function touchCollect(folderNames, nameKeywords, radius)
	if not canFireTouch then
		return 0
	end
	local hrp = getHRP()
	if not hrp then
		return 0
	end
	local collected = 0
	for _, folderName in ipairs(folderNames) do
		local folder = Workspace:FindFirstChild(folderName)
		if folder then
			for _, item in ipairs(folder:GetChildren()) do
				local part = item:IsA("BasePart") and item
					or (item:IsA("Model") and (item.PrimaryPart or item:FindFirstChildWhichIsA("BasePart")))
				if part and (part.Position - hrp.Position).Magnitude <= radius then
					if not nameKeywords or matchesAny(item.Name, nameKeywords) or matchesAny(part.Name, nameKeywords) then
						firetouchinterest(hrp, part, 0)
						firetouchinterest(hrp, part, 1)
						collected += 1
					end
				end
			end
		end
	end
	return collected
end

-- Teleports to a named location only when we have drifted outside `leash`,
-- so a route automation is not spamming the hole teleport every cycle.
local function travelTo(locationName, leash)
	local pos = resolveLocation(locationName)
	if not pos then
		return false
	end
	local hrp = getHRP()
	if not hrp then
		return false
	end
	if (hrp.Position - pos).Magnitude > (leash or 120) then
		teleportTo(pos)
	end
	return true
end

-- ============================================================
-- AUTOMATION RUNNER
-- Each module is one cooperative thread that calls its Step on an interval.
-- Errors are caught per step so a missing workspace object pauses that one
-- module instead of killing the loop.
-- ============================================================
local AutomationStates = {}

local function startAutomation(state)
	if state.thread then
		return
	end
	state.thread = task.spawn(function()
		while not Unloaded and state.enabled do
			local ok, err = pcall(state.step, state)
			if not ok then
				warn("[Automation] " .. state.name .. ": " .. tostring(err))
			end
			task.wait(state.interval)
		end
		state.thread = nil
	end)
end

local function setAutomation(state, on)
	state.enabled = on
	if on then
		startAutomation(state)
	end
end

-- ============================================================
-- MISC HELPERS (CFly / Infinite Jump / WS+JP / Click TP / Fog)
-- ============================================================

-- CFly.
-- The old version only zeroed velocity on Heartbeat, so gravity still
-- accumulated between frames and you sank toward the ground. This version
-- keeps its own authoritative `flyPos` and rewrites HumanoidRootPart.CFrame
-- from it every Heartbeat, so any displacement physics applied in between is
-- discarded outright - you hold altitude exactly. PlatformStand stops the
-- humanoid from fighting back with walk/fall states.
--
-- Controls: W/S fly along the camera look vector (pitch included, so look up
-- and hold W to climb), A/D strafe horizontally, Space rises, LeftShift
-- descends. Release everything and you stay put.
local cflyConnection = nil
local flyPos = nil

local function cflyKeyDown(key)
	-- never read movement keys while a textbox (including a keybind capture
	-- field) has focus
	if UserInputService:GetFocusedTextBox() then
		return false
	end
	return UserInputService:IsKeyDown(key)
end

local function SetCFly(on)
	if on then
		if cflyConnection then
			return
		end
		local hrp = getHRP()
		flyPos = hrp and hrp.Position or nil
		cflyConnection = RunService.Heartbeat:Connect(function(dt)
			local hrp = getHRP()
			local humanoid = getHumanoid()
			local cam = Workspace.CurrentCamera
			if not (hrp and humanoid and cam) then
				flyPos = nil
				return
			end

			-- Re-seed after a respawn or an external teleport, otherwise we
			-- would yank the character back to a stale hover point.
			if not flyPos or (hrp.Position - flyPos).Magnitude > 60 then
				flyPos = hrp.Position
			end

			if not humanoid.PlatformStand then
				humanoid.PlatformStand = true
			end

			local camCF = cam.CFrame
			local look = camCF.LookVector
			local flatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z)
			flatRight = flatRight.Magnitude > 0.001 and flatRight.Unit or Vector3.zero

			local move = Vector3.zero
			if cflyKeyDown(CFlyKeys.Forward) then
				move += look
			end
			if cflyKeyDown(CFlyKeys.Back) then
				move -= look
			end
			if cflyKeyDown(CFlyKeys.Left) then
				move -= flatRight
			end
			if cflyKeyDown(CFlyKeys.Right) then
				move += flatRight
			end
			if cflyKeyDown(CFlyKeys.Up) then
				move += Vector3.new(0, 1, 0)
			end
			if cflyKeyDown(CFlyKeys.Down) then
				move -= Vector3.new(0, 1, 0)
			end

			-- Thumbstick / mobile fallback: PlatformStand zeroes MoveDirection
			-- on most devices, but when it does report input, honour it.
			-- flatLook is guarded because looking straight down or straight up
			-- flattens to a zero vector, and Vector3.zero.Unit is NaN.
			if move.Magnitude <= 0.001 and humanoid.MoveDirection.Magnitude > 0.05 then
				local flatLook = Vector3.new(look.X, 0, look.Z)
				flatLook = flatLook.Magnitude > 0.001 and flatLook.Unit or flatRight
				local md = humanoid.MoveDirection
				move = (flatRight * md:Dot(flatRight)) + (look * md:Dot(flatLook))
			end

			if move.Magnitude > 0.001 then
				flyPos = flyPos + move.Unit * (Config.CFlySpeed * dt)
			end

			-- Preserve the character's own facing; only the position is ours.
			hrp.CFrame = CFrame.new(flyPos) * hrp.CFrame.Rotation
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end)
	else
		if cflyConnection then
			cflyConnection:Disconnect()
			cflyConnection = nil
		end
		flyPos = nil
		local humanoid = getHumanoid()
		if humanoid then
			humanoid.PlatformStand = false
		end
	end
end

-- Infinite jump.
local infJumpConnection = UserInputService.JumpRequest:Connect(function()
	if not Config.InfiniteJump then
		return
	end
	local humanoid = getHumanoid()
	if humanoid then
		humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	end
end)

-- WalkSpeed / JumpPower enforcement: re-applies every frame so the game
-- can't reset your stats.
local enforceConnection = RunService.Heartbeat:Connect(function()
	local humanoid = getHumanoid()
	if not humanoid then
		return
	end
	if Config.WalkSpeedEnabled then
		humanoid.WalkSpeed = Config.WalkSpeed
	end
	if Config.JumpPowerEnabled then
		humanoid.JumpPower = Config.JumpPower
	end
end)

-- Click teleport: modifier key (default LeftControl) + left click.
local clickTpConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then
		return
	end
	if not Config.ClickTeleport then
		return
	end
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 then
		return
	end
	-- Escape clears a Keybind, which leaves ClickTeleportKey nil. Treat that as
	-- "no modifier required" instead of erroring in IsKeyDown.
	if Config.ClickTeleportKey and not UserInputService:IsKeyDown(Config.ClickTeleportKey) then
		return
	end
	local hrp = getHRP()
	local mouse = LocalPlayer:GetMouse()
	if hrp and mouse and mouse.Hit then
		hrp.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0))
		-- keep CFly's hover point in sync with the jump
		if flyPos then
			flyPos = hrp.Position
		end
	end
end)

-- Remove fog: destroys Fogbox + Fog script, and while toggled on, keeps
-- destroying any Fogbox that reappears.
local fogWatcher = nil
local function DestroyFog()
	local charFolder = Workspace:FindFirstChild(LocalPlayer.Name)
	local fogbox = charFolder and charFolder:FindFirstChild("Fogbox")
	if fogbox then
		fogbox:Destroy()
	end
	local fogScript = LocalPlayer:FindFirstChild("PlayerScripts")
		and LocalPlayer.PlayerScripts:FindFirstChild("Fog")
	if fogScript then
		fogScript:Destroy()
	end
end

local function SetRemoveFog(on)
	if on then
		DestroyFog()
		if fogWatcher then
			return
		end
		local charFolder = Workspace:FindFirstChild(LocalPlayer.Name)
		if charFolder then
			fogWatcher = charFolder.ChildAdded:Connect(function(child)
				if child.Name == "Fogbox" then
					task.defer(function()
						child:Destroy()
					end)
				end
			end)
		end
	elseif fogWatcher then
		fogWatcher:Disconnect()
		fogWatcher = nil
	end
end

