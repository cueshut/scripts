	if Unloaded then
		return
	end
	if MeleeConnection then
		MeleeConnection:Disconnect()
		MeleeConnection = nil
	end
	SetupMeleeAura()
	if fogWatcher then
		fogWatcher:Disconnect()
		fogWatcher = nil
	end
	if Config.RemoveFog then
		SetRemoveFog(true)
	end
	-- the old hover point belongs to the dead character
	flyPos = nil
end)

