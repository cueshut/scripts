-- The teleport logic yields (it waits on the hole), so never run it inside a
-- UI callback thread; spawn it instead.
local function runTeleport(displayName, location)
	local pos
	if location.Resolve then
		pos = location.Resolve()
	else
		pos = location.Position
	end
	if not pos then
		window:Notify({
			Title = "Teleport",
			Content = displayName .. " was not found in the workspace.",
			Duration = 3,
		})
		return
	end
	window:Notify({
